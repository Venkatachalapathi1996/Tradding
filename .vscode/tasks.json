{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Django Server",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "runserver"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Make Migrations",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "makemigrations"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Migrate Database",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "migrate"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Create Superuser",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "createsuperuser"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Django Shell",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "shell"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "test"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Collect Static Files",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "collectstatic",
                "--noinput"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Start Celery Worker",
            "type": "shell",
            "command": "celery",
            "args": [
                "-A",
                "trading_assistant",
                "worker",
                "--loglevel=info",
                "--pool=solo"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Start Celery Beat",
            "type": "shell",
            "command": "celery",
            "args": [
                "-A",
                "trading_assistant",
                "beat",
                "--loglevel=info"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Check Django",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "manage.py",
                "check"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "Install Requirements",
            "type": "shell",
            "command": "${config:python.defaultInterpreterPath}",
            "args": [
                "-m",
                "pip",
                "install",
                "-r",
                "requirements.txt"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}
